    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "sprites": "node scripts/generate-sprites.mjs",
    "e2e": "node e2e/lance.mjs"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.65",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "aedes": "^0.51.3",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "playwright": "^1.56.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.5",
    "ws": "^8.22.0"
  }
