{
  "name": "face-off",
  "version": "0.36.3",
  "private": true,
  "description": "Face-Off — hockey arcade en pixel art (humain vs CPU, ou à deux sur le même Wi-Fi).",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
