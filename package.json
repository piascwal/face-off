    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "sprites": "node scripts/generate-sprites.mjs",
    "e2e": "node e2e/lance.mjs"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.65",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "aedes": "^1.2.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "playwright": "^1.56.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
  },
  "dependencies": {
    "@piascwal/lan-kit": "github:piascwal/lan-kit#v0.2.0"
  }
